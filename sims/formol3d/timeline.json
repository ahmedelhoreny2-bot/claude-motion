{
 "fps": 30,
 "duration": 180.77,
 "sentences": [
  {
   "n": 1,
   "ch": "intro",
   "at": 2.4,
   "src": [
    0.0,
    6.955
   ],
   "dur": 6.955,
   "text": "مرحباً بكم. في هذا الفيديو، سنتعرّف على طريقةِ تقديرِ نسبةِ البروتين في اللبن… بطريقةِ الفورمول."
  },
  {
   "n": 2,
   "ch": "protein",
   "at": 10.405,
   "src": [
    6.955,
    10.025
   ],
   "dur": 3.07,
   "text": "يتكوّنُ البروتينُ في اللبن من سلاسلَ طويلة…"
  },
  {
   "n": 3,
   "ch": "protein",
   "at": 13.755,
   "src": [
    10.025,
    13.595
   ],
   "dur": 3.57,
   "text": "والوحدةُ الأساسيةُ لهذه السلاسل، هي الحمضُ الأميني."
  },
  {
   "n": 4,
   "ch": "protein",
   "at": 17.605,
   "src": [
    13.595,
    18.49
   ],
   "dur": 4.895,
   "text": "فإذا استطعنا تقديرَ الأحماضِ الأمينية، أمكنَنا حسابُ نسبةِ البروتين."
  },
  {
   "n": 5,
   "ch": "amino",
   "at": 23.55,
   "src": [
    18.49,
    23.155
   ],
   "dur": 4.665,
   "text": "يحتوي كلُّ حمضٍ أمينيّ على مجموعةِ أمين، ذاتِ تأثيرٍ قاعدي،"
  },
  {
   "n": 6,
   "ch": "amino",
   "at": 28.495,
   "src": [
    23.155,
    26.06
   ],
   "dur": 2.905,
   "text": "ومجموعةِ كربوكسيل، ذاتِ تأثيرٍ حامضي."
  },
  {
   "n": 7,
   "ch": "amino",
   "at": 31.68,
   "src": [
    26.06,
    31.705
   ],
   "dur": 5.645,
   "text": "وتُعادِلُ كلٌّ منهما الأخرى… لذلك لا يمكنُ معايرةُ الحمضِ الأمينيِّ مباشرةً."
  },
  {
   "n": 8,
   "ch": "react",
   "at": 38.375,
   "src": [
    31.705,
    34.225
   ],
   "dur": 2.52,
   "text": "وهنا… يأتي دورُ الفورمالين."
  },
  {
   "n": 9,
   "ch": "react",
   "at": 41.175,
   "src": [
    34.225,
    40.595
   ],
   "dur": 6.37,
   "text": "إذ يتّحدُ الفورمالدهيد مع مجموعةِ الأمين، فيُلغي تأثيرَها القاعدي، ويتكوّنُ جزيءُ ماء."
  },
  {
   "n": 10,
   "ch": "react",
   "at": 47.825,
   "src": [
    40.595,
    44.755
   ],
   "dur": 4.16,
   "text": "فتصبحُ مجموعةُ الكربوكسيل حرّة، ويظهرُ تأثيرُها الحامضي."
  },
  {
   "n": 11,
   "ch": "react",
   "at": 52.265,
   "src": [
    44.755,
    50.355
   ],
   "dur": 5.6,
   "text": "وكلُّ مجموعةِ كربوكسيل نُعادلُها، تقابلُ حمضاً أمينياً… أي بروتيناً."
  },
  {
   "n": 12,
   "ch": "setup",
   "at": 58.915,
   "src": [
    50.355,
    54.955
   ],
   "dur": 4.6,
   "text": "نبدأ بتجهيزِ التجربة: نضعُ في الدورق عشرةَ مليلتراتٍ من اللبن،"
  },
  {
   "n": 13,
   "ch": "setup",
   "at": 63.795,
   "src": [
    54.955,
    61.54
   ],
   "dur": 6.585,
   "text": "ثم نضيفُ ثلاثَ قطراتٍ من دليلِ الفينولفثالين، ونملأُ السحاحةَ بهيدروكسيدِ الصوديوم، عُشرِ عياري."
  },
  {
   "n": 14,
   "ch": "setup",
   "at": 70.66,
   "src": [
    61.54,
    69.105
   ],
   "dur": 7.565,
   "text": "يكونُ الدليلُ عديمَ اللون في الوسطِ الحامضي، ووردياً خفيفاً عند التعادل، وأحمرَ وردياً في الوسطِ القلوي."
  },
  {
   "n": 15,
   "ch": "t1",
   "at": 79.275,
   "src": [
    69.105,
    74.465
   ],
   "dur": 5.36,
   "text": "المعايرةُ الأولى: يحتوي اللبنُ على حموضةٍ طبيعية، يجبُ التخلّصُ منها أولاً."
  },
  {
   "n": 16,
   "ch": "t1",
   "at": 84.915,
   "src": [
    74.465,
    80.84
   ],
   "dur": 6.375,
   "text": "نضيفُ القلويَّ قطرةً قطرة مع الرجّ، حتى يظهرَ لونٌ ورديٌّ خفيفٌ ثابت… فنتوقّف."
  },
  {
   "n": 17,
   "ch": "t1",
   "at": 91.57,
   "src": [
    80.84,
    89.19
   ],
   "dur": 8.35,
   "text": "ومن الحجمِ المستهلك، نحسبُ نسبةَ الحموضة مقدّرةً كحمضِ لاكتيك… وهي هنا صفر فاصل مئة وأربعة وأربعون في المئة."
  },
  {
   "n": 18,
   "ch": "form",
   "at": 100.97,
   "src": [
    89.19,
    93.085
   ],
   "dur": 3.895,
   "text": "نضيفُ الآن اثنين مليلتر من الفورمالين، إلى الدورقِ نفسه."
  },
  {
   "n": 19,
   "ch": "form",
   "at": 105.145,
   "src": [
    93.085,
    99.475
   ],
   "dur": 6.39,
   "text": "لاحِظوا! اختفى اللونُ الوردي… لأنَّ مجموعاتِ الكربوكسيل تحرّرت، فأصبح الوسطُ حامضياً."
  },
  {
   "n": 20,
   "ch": "form",
   "at": 111.815,
   "src": [
    99.475,
    103.275
   ],
   "dur": 3.8,
   "text": "ولا نحتاجُ إلى إضافةِ دليلٍ جديد، فهو موجودٌ بالفعل."
  },
  {
   "n": 21,
   "ch": "t2",
   "at": 116.665,
   "src": [
    103.275,
    108.88
   ],
   "dur": 5.605,
   "text": "المعايرةُ الثانية: نُعايرُ مرّةً أخرى بالقلوي، حتى يعودَ اللونُ الورديُّ الخفيف."
  },
  {
   "n": 22,
   "ch": "t2",
   "at": 122.55,
   "src": [
    108.88,
    112.97
   ],
   "dur": 4.09,
   "text": "وهذا الحجمُ المستهلك، هو الذي يُعبّرُ عن الأحماضِ الأمينية."
  },
  {
   "n": 23,
   "ch": "blank",
   "at": 127.69,
   "src": [
    112.97,
    118.295
   ],
   "dur": 5.325,
   "text": "تجربةُ البلانك: نكرّرُ الخطواتِ نفسَها، مستخدمين الماءَ بدلاً من اللبن،"
  },
  {
   "n": 24,
   "ch": "blank",
   "at": 133.295,
   "src": [
    118.295,
    121.77
   ],
   "dur": 3.475,
   "text": "وذلك لاستبعادِ الحموضةِ الناتجةِ عن الفورمالين نفسِه."
  },
  {
   "n": 25,
   "ch": "blank",
   "at": 137.05,
   "src": [
    121.77,
    127.625
   ],
   "dur": 5.855,
   "text": "رقمُ الفورمول: اثنان، ناقص صفر فاصل اثنين… يساوي واحداً فاصل ثمانية."
  },
  {
   "n": 26,
   "ch": "calc",
   "at": 143.955,
   "src": [
    127.625,
    135.775
   ],
   "dur": 8.15,
   "text": "نسبةُ البروتين في اللبنِ البقري، تساوي رقمَ الفورمول مضروباً في واحد فاصل سبعة وستين… أي نحو ثلاثة في المئة."
  },
  {
   "n": 27,
   "ch": "calc",
   "at": 152.385,
   "src": [
    135.775,
    139.885
   ],
   "dur": 4.11,
   "text": "أمّا في اللبنِ الجاموسي، فنضربُ في واحد فاصل ستة وستين،"
  },
  {
   "n": 28,
   "ch": "calc",
   "at": 156.775,
   "src": [
    139.885,
    145.685
   ],
   "dur": 5.8,
   "text": "وتتراوحُ نسبةُ البروتين فيه، بين ثلاثة فاصل ثلاثة، وأربعة فاصل خمسة في المئة."
  },
  {
   "n": 29,
   "ch": "outro",
   "at": 163.625,
   "src": [
    145.685,
    149.07
   ],
   "dur": 3.385,
   "text": "وهذه هي الطريقةُ كاملةً… في خمسِ خطوات."
  },
  {
   "n": 30,
   "ch": "outro",
   "at": 167.29,
   "src": [
    149.07,
    158.35
   ],
   "dur": 9.28,
   "text": "وبذلك نكونُ قد تعرّفنا على تقديرِ البروتين في اللبن بطريقةِ الفورمول. قسمُ علومِ الأغذية… كليةُ الزراعة… جامعةُ عين شمس."
  }
 ],
